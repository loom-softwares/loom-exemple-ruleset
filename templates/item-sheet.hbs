<!--
  Loom Demo System — item-sheet.hbs
  Custom sheet for items (weapons, armor, potions, scrolls).
-->
<div class="loom-item-sheet">
  <!-- Item Header: Icon + Name + Type -->
  <header class="loom-item-header">
    <div class="loom-item-img-frame" data-action="pick-portrait" data-edit="imgUrl" title="Click to change item image">
      {{#if document.imgUrl}}
        <img src="{{document.imgUrl}}" alt="{{document.name}}" class="loom-item-img" />
      {{else}}
        <div class="loom-item-placeholder">
          {{#if isWeapon}}<i class="fa-solid fa-khanda"></i>
          {{else if isArmor}}<i class="fa-solid fa-shield-halved"></i>
          {{else if isPotion}}<i class="fa-solid fa-flask-round-potion"></i>
          {{else}}<i class="fa-solid fa-box-open"></i>{{/if}}
        </div>
      {{/if}}
      <div class="item-img-overlay">
        <i class="fa-solid fa-camera"></i>
      </div>
    </div>

    <div class="loom-item-identity">
      <div class="item-type-tag">
        <span class="type-badge">
          {{#if isWeapon}}<i class="fa-solid fa-swords"></i> Weapon
          {{else if isArmor}}<i class="fa-solid fa-shield"></i> Armor
          {{else if isPotion}}<i class="fa-solid fa-flask"></i> Potion
          {{else if isScroll}}<i class="fa-solid fa-scroll"></i> Scroll
          {{else}}<i class="fa-solid fa-box"></i> Item{{/if}}
        </span>
      </div>
      <input
        type="text"
        name="name"
        value="{{document.name}}"
        placeholder="Item Name..."
        class="loom-item-name-input"
        autocomplete="off"
      />
    </div>
  </header>

  <!-- Item Body with Type-Specific Properties -->
  <div class="loom-item-body">
    {{#if isWeapon}}
      <div class="loom-item-props-grid">
        <div class="item-prop-card">
          <label><i class="fa-solid fa-dice-d20"></i> Damage Formula</label>
          <input type="text" name="sd:damage" value="{{systemData.damage}}" placeholder="e.g. 1d8, 2d6" class="prop-input" />
        </div>
        <div class="item-prop-card">
          <label><i class="fa-solid fa-burst"></i> Damage Type</label>
          <input type="text" name="sd:damageType" value="{{systemData.damageType}}" placeholder="e.g. Slashing, Fire" class="prop-input" />
        </div>
        <div class="item-prop-card">
          <label><i class="fa-solid fa-bullseye"></i> Range</label>
          <input type="text" name="sd:range" value="{{systemData.range}}" placeholder="e.g. Melee, 30 ft" class="prop-input" />
        </div>
      </div>

      <div class="loom-item-action-box">
        <button type="button" class="loom-roll-btn item-roll-btn" data-action="roll-damage">
          <i class="fa-solid fa-dice-d20"></i> Roll Weapon Damage ({{systemData.damage}})
        </button>
      </div>
    {{/if}}

    {{#if isArmor}}
      <div class="loom-item-props-grid single">
        <div class="item-prop-card">
          <label><i class="fa-solid fa-shield"></i> Defense Bonus</label>
          <input type="number" name="sd:defenseBonus" value="{{systemData.defenseBonus}}" class="prop-input" />
        </div>
      </div>
    {{/if}}

    {{#if isPotion}}
      <div class="loom-item-props-grid single">
        <div class="item-prop-card">
          <label><i class="fa-solid fa-heart-pulse"></i> Healing / Effect</label>
          <input type="text" name="sd:healAmount" value="{{systemData.healAmount}}" placeholder="e.g. 2d4+2" class="prop-input" />
        </div>
      </div>
    {{/if}}

    <!-- General Description -->
    <div class="loom-item-desc-section">
      <label><i class="fa-solid fa-align-left"></i> Description & Notes</label>
      <textarea name="sd:description" placeholder="Describe the properties or lore of this item..." rows="4" class="loom-item-textarea">{{systemData.description}}</textarea>
    </div>
  </div>
</div>
