<!--
  Loom Demo System — item-sheet.hbs
  Custom sheet for items (weapons, armor, potions, scrolls).
  Items define properties and bonuses; rolls are performed by the character on their sheet.
-->
<div class="loom-item-sheet">
  <!-- Item Header: Icon + Name + Type -->
  <header class="loom-item-header">
    <div class="loom-item-img-frame" data-action="pick-portrait" data-edit="imgUrl" title="{{localize "loom-demo-system.sheet.portrait.clickToChange"}}">
      {{#if document.imgUrl}}
        <img src="{{document.imgUrl}}" alt="{{document.name}}" class="loom-item-img" />
      {{else}}
        <div class="loom-item-placeholder">
          {{#if isWeapon}}<i class="fa-solid fa-khanda"></i>
          {{else if isArmor}}<i class="fa-solid fa-shield-halved"></i>
          {{else if isPotion}}<i class="fa-solid fa-flask-round-potion"></i>
          {{else}}<i class="fa-solid fa-box-open"></i>{{/if}}
        </div>
      {{/if}}
      <div class="item-img-overlay">
        <i class="fa-solid fa-camera"></i>
      </div>
    </div>

    <div class="loom-item-identity">
      <div class="item-type-tag">
        <span class="type-badge">
          {{#if isWeapon}}<i class="fa-solid fa-swords"></i> {{localize "loom-demo-system.items.weapon"}}
          {{else if isArmor}}<i class="fa-solid fa-shield"></i> {{localize "loom-demo-system.items.armor"}}
          {{else if isPotion}}<i class="fa-solid fa-flask"></i> {{localize "loom-demo-system.items.potion"}}
          {{else if isScroll}}<i class="fa-solid fa-scroll"></i> {{localize "loom-demo-system.items.scroll"}}
          {{else}}<i class="fa-solid fa-box"></i> {{localize "loom-demo-system.items.newItem"}}{{/if}}
        </span>
      </div>
      <input
        type="text"
        name="name"
        value="{{document.name}}"
        placeholder="{{localize "loom-demo-system.items.namePlaceholder"}}"
        class="loom-item-name-input"
        autocomplete="off"
      />
    </div>
  </header>

  <!-- Item Body with Type-Specific Properties & Bonuses -->
  <div class="loom-item-body">
    {{#if isWeapon}}
      <div class="loom-item-props-grid">
        <div class="item-prop-card">
          <label><i class="fa-solid fa-dice-d20"></i> {{localize "loom-demo-system.items.damageFormula"}}</label>
          <input type="text" name="sd:damage" value="{{systemData.damage}}" placeholder="e.g. 1d8, 2d6" class="prop-input" />
        </div>
        <div class="item-prop-card">
          <label><i class="fa-solid fa-burst"></i> {{localize "loom-demo-system.items.damageType"}}</label>
          <input type="text" name="sd:damageType" value="{{systemData.damageType}}" placeholder="e.g. Slashing, Fire" class="prop-input" />
        </div>
        <div class="item-prop-card">
          <label><i class="fa-solid fa-bullseye"></i> {{localize "loom-demo-system.items.range"}}</label>
          <input type="text" name="sd:range" value="{{systemData.range}}" placeholder="e.g. Melee, 30 ft" class="prop-input" />
        </div>
        <div class="item-prop-card">
          <label><i class="fa-solid fa-crosshairs"></i> {{localize "loom-demo-system.items.attackBonus"}}</label>
          <input type="number" name="sd:attackBonus" value="{{systemData.attackBonus}}" placeholder="0" class="prop-input" />
        </div>
        <div class="item-prop-card">
          <label><i class="fa-solid fa-burst"></i> {{localize "loom-demo-system.items.damageBonus"}}</label>
          <input type="number" name="sd:damageBonus" value="{{systemData.damageBonus}}" placeholder="0" class="prop-input" />
        </div>
      </div>
    {{/if}}

    {{#if isArmor}}
      <div class="loom-item-props-grid">
        <div class="item-prop-card">
          <label><i class="fa-solid fa-shield"></i> {{localize "loom-demo-system.items.defenseBonus"}}</label>
          <input type="number" name="sd:defenseBonus" value="{{systemData.defenseBonus}}" placeholder="0" class="prop-input" />
        </div>
        <div class="item-prop-card">
          <label><i class="fa-solid fa-heart"></i> {{localize "loom-demo-system.items.hpBonus"}}</label>
          <input type="number" name="sd:hpBonus" value="{{systemData.hpBonus}}" placeholder="0" class="prop-input" />
        </div>
      </div>
    {{/if}}

    {{#if isPotion}}
      <div class="loom-item-props-grid single">
        <div class="item-prop-card">
          <label><i class="fa-solid fa-heart-pulse"></i> {{localize "loom-demo-system.items.healing"}}</label>
          <input type="text" name="sd:healAmount" value="{{systemData.healAmount}}" placeholder="e.g. 2d4+2" class="prop-input" />
        </div>
      </div>
    {{/if}}

    {{#if isScroll}}
      <div class="loom-item-props-grid">
        <div class="item-prop-card">
          <label><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "loom-demo-system.items.effect"}}</label>
          <input type="text" name="sd:effect" value="{{systemData.effect}}" placeholder="e.g. +2 Swift" class="prop-input" />
        </div>
        <div class="item-prop-card">
          <label><i class="fa-solid fa-hand-fist"></i> {{localize "loom-demo-system.items.mightBonus"}}</label>
          <input type="number" name="sd:mightBonus" value="{{systemData.mightBonus}}" placeholder="0" class="prop-input" />
        </div>
        <div class="item-prop-card">
          <label><i class="fa-solid fa-person-running"></i> {{localize "loom-demo-system.items.swiftBonus"}}</label>
          <input type="number" name="sd:swiftBonus" value="{{systemData.swiftBonus}}" placeholder="0" class="prop-input" />
        </div>
        <div class="item-prop-card">
          <label><i class="fa-solid fa-brain"></i> {{localize "loom-demo-system.items.witsBonus"}}</label>
          <input type="number" name="sd:witsBonus" value="{{systemData.witsBonus}}" placeholder="0" class="prop-input" />
        </div>
      </div>
    {{/if}}

    <!-- General Description -->
    <div class="loom-item-desc-section">
      <label><i class="fa-solid fa-align-left"></i> {{localize "loom-demo-system.items.description"}}</label>
      <textarea name="sd:description" placeholder="{{localize "loom-demo-system.items.descPlaceholder"}}" rows="4" class="loom-item-textarea">{{systemData.description}}</textarea>
    </div>
  </div>
</div>
